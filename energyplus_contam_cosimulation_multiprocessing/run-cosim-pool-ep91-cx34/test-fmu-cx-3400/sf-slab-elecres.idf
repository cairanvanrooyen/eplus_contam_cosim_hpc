    ,                        !- Time Storage Can Meet Peak Draw {hr}
    ,                        !- Time for Tank Recovery {hr}
    ,                        !- Nominal Tank Volume for Autosizing Plant Connections {m3}
    3,                       !- Number of Bedrooms
    3;                       !- Number of Bathrooms


