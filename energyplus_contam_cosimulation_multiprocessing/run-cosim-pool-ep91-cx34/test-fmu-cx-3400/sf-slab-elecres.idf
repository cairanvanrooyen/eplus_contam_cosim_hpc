    ahs_HvacUnitarySystem,   !- Name
    always_avail,            !- Availability Schedule Name
    ahs_oamixer_mixed_node,  !- Unitary System Air Inlet Node Name
    ahs_supply_side_outlet_node,  !- Unitary System Air Outlet Node Name
    fan_cycle,               !- Supply Air Fan Operating Mode Schedule Name
    80.0,                    !- Maximum Supply Air Temperature {C}
    autosize,                !- Cooling Supply Air Flow Rate {m3/s}
    autosize,                !- Heating Supply Air Flow Rate {m3/s}
    0.0,                     !- No Load Supply Air Flow Rate {m3/s}
    1_first,                 !- Controlling Zone or Thermostat Location
    Fan:OnOff,               !- Supply Fan Object Type
    ahs_SupplyFan,           !- Supply Fan Name
    BlowThrough,             !- Fan Placement
    Coil:Heating:Electric,   !- Heating Coil Object Type
    ahs_HeatingCoil,         !- Heating Coil Name
    Coil:Cooling:DX:SingleSpeed,  !- Cooling Coil Object Type
    ahs_CoolingCoil,         !- Cooling Coil Name
    None;                    !- Dehumidification Control Type


!-   ===========  ALL OBJECTS IN CLASS: CONTROLLER:OUTDOORAIR ===========

Controller:OutdoorAir,
    ahs_oa_controller,       !- Name
    ahs_oamixer_relief_node, !- Relief Air Outlet Node Name
    ahs_supply_side_inlet_node,  !- Return Air Node Name
    ahs_oamixer_mixed_node,  !- Mixed Air Node Name
    ahs_oamixer_outdoor_node,!- Actuator Node Name
    autosize,                !- Minimum Outdoor Air Flow Rate {m3/s}
    autosize,                !- Maximum Outdoor Air Flow Rate {m3/s}
    NoEconomizer,            !- Economizer Control Type
    ModulateFlow,            !- Economizer Control Action Type
    0.0,                     !- Economizer Maximum Limit Dry-Bulb Temperature {C}
    0.0,                     !- Economizer Maximum Limit Enthalpy {J/kg}
    0.0,                     !- Economizer Maximum Limit Dewpoint Temperature {C}
    ,                        !- Electronic Enthalpy Limit Curve Name
    0.0,                     !- Economizer Minimum Limit Dry-Bulb Temperature {C}
    NoLockout,               !- Lockout Type
    ProportionalMinimum,     !- Minimum Limit Type
    ,                        !- Minimum Outdoor Air Schedule Name
    ,                        !- Minimum Fraction of Outdoor Air Schedule Name
    ,                        !- Maximum Fraction of Outdoor Air Schedule Name
    ,                        !- Mechanical Ventilation Controller Name
    ,                        !- Time of Day Economizer Control Schedule Name
    No,                      !- High Humidity Control
    ,                        !- Humidistat Control Zone Name
    1.0,                     !- High Humidity Outdoor Air Flow Ratio
    Yes,                     !- Control High Indoor Humidity Based on Outdoor Humidity Ratio
    BypassWhenWithinEconomizerLimits;  !- Heat Recovery Bypass Control Type


