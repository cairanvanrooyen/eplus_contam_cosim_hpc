!-   ===========  ALL OBJECTS IN CLASS: WATERHEATER:MIXED ===========

WaterHeater:Mixed,
    Water Heater_unit1,      !- Name
    0.196841372,             !- Tank Volume {m3}
    dhw_setpt,               !- Setpoint Temperature Schedule Name
    2.0,                     !- Deadband Temperature Difference {deltaC}
    50.0,                    !- Maximum Temperature Limit {C}
    Cycle,                   !- Heater Control Type
    autosize,                !- Heater Maximum Capacity {W}
    0.0,                     !- Heater Minimum Capacity {W}
    0.0,                     !- Heater Ignition Minimum Flow Rate {m3/s}
    ,                        !- Heater Ignition Delay {s}
    electricity,             !- Heater Fuel Type
    1.0,                     !- Heater Thermal Efficiency
    ,                        !- Part Load Factor Curve Name
    ,                        !- Off Cycle Parasitic Fuel Consumption Rate {W}
    ,                        !- Off Cycle Parasitic Fuel Type
    ,                        !- Off Cycle Parasitic Heat Fraction to Tank
    ,                        !- On Cycle Parasitic Fuel Consumption Rate {W}
    ,                        !- On Cycle Parasitic Fuel Type
    ,                        !- On Cycle Parasitic Heat Fraction to Tank
    Zone,                    !- Ambient Temperature Indicator
    ,                        !- Ambient Temperature Schedule Name
    1_first,                 !- Ambient Temperature Zone Name
    ,                        !- Ambient Temperature Outdoor Air Node Name
    1.33066161209134,        !- Off Cycle Loss Coefficient to Ambient Temperature {W/K}
    1,                       !- Off Cycle Loss Fraction to Zone
    1.33066161209134,        !- On Cycle Loss Coefficient to Ambient Temperature {W/K}
    1.0,                     !- On Cycle Loss Fraction to Zone
    0.0,                     !- Peak Use Flow Rate {m3/s}
    ,                        !- Use Flow Rate Fraction Schedule Name
    ,                        !- Cold Water Supply Temperature Schedule Name
    Water Heater use inlet node_unit1,  !- Use Side Inlet Node Name
    Water Heater use outlet node_unit1,  !- Use Side Outlet Node Name
    1.0,                     !- Use Side Effectiveness
    ,                        !- Source Side Inlet Node Name
    ,                        !- Source Side Outlet Node Name
    1.0,                     !- Source Side Effectiveness
    autosize,                !- Use Side Design Flow Rate {m3/s}
    0.0,                     !- Source Side Design Flow Rate {m3/s}
    1.5;                     !- Indirect Water Heating Recovery Time {hr}


!-   ===========  ALL OBJECTS IN CLASS: WATERHEATER:SIZING ===========

WaterHeater:Sizing,
    Water Heater_unit1,      !- WaterHeater Name
